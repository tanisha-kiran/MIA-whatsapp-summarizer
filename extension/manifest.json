{
  "manifest_version": 3,
  "name": "MIA — Local WhatsApp Catch-Up",
  "version": "0.1.0",
  "description": "Privacy-first local assistant for understanding what you missed on WhatsApp Web.",
  "permissions": ["storage", "notifications", "tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_title": "MIA — What did I miss?",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}